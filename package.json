{
  "name": "findbird-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm validate:questions && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "validate:questions": "node scripts/validate-questions.mjs",
    "import:questions": "node scripts/import-questions.mjs",
    "import:initial": "node scripts/import-questions.mjs --source ../new_photo",
    "play:local": "vite preview --host 127.0.0.1",
    "play:lan": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
